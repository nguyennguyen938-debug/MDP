      "source": "embedded_pilot_catalog",
      "source_code": "def solve(numbers: list[int], delimiter: int) -> list[int]:\n    out = []\n    for idx, number in enumerate(numbers):\n        if idx:\n            out.append(delimiter)\n        out.append(number)\n    return out\n",
      "split": "train"
    },
